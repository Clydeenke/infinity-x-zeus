// Stub defaults for upstream test modules (CTS/MTS suites are parse-only
// in this build; `bacon` never compiles them. Definitions live in the
// full cts/test repos which are not part of this device's checkout.)
java_defaults {
    name: "cts_defaults",
}

java_defaults {
    name: "cts_error_prone_rules",
}

java_defaults {
    name: "mts-target-sdk-version-current",
}

java_defaults {
    name: "cts_support_defaults",
}

cc_defaults {
    name: "cts_bionic_defaults",
    // Only the primary (64-bit) variant: the 32-bit variant installs its
    // license metadata to the same cts_root testcases path and kati errors
    // out with "cannot copy target from multiple modules".
    compile_multilib: "64",
}

java_library {
    name: "vogarexpectlib",
    host_supported: true,
}

// 主机侧测试工具 stub —— 仅被 java_test_host 引用，bacon 不编译
